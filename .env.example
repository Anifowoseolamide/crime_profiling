# Django Core Settings
SECRET_KEY=django-insecure-lagoscp-change-in-production-immediately
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# For local development:
DB_NAME=lagoscp_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Database connection string (used in production / Render)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Cloudinary Configuration (Media Storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# JWT Token Lifetime (in minutes)
JWT_ACCESS_TOKEN_LIFETIME=120
JWT_REFRESH_TOKEN_LIFETIME=1440

# Face Recognition Configuration
# Options: 'facepp' or 'compreface'
FACE_RECOGNITION_PROVIDER=facepp

# Face++ Credentials
FACEPP_API_KEY=your-facepp-api-key
FACEPP_API_SECRET=your-facepp-api-secret
FACEPP_THRESHOLD=80
FACEPP_REGION=api-us
FACEPP_OUTER_ID=lagoscp_faceset

# CompreFace Credentials (leave COMPREFACE_URL blank to enable Mock Mode)
COMPREFACE_URL=
COMPREFACE_API_KEY=
COMPREFACE_THRESHOLD=0.85
COMPREFACE_DET_PROB_THRESHOLD=0.8

# Frontend Integration
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
