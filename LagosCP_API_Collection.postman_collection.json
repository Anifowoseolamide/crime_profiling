						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"image\": \"data:image/jpeg;base64,...(base64_string)...\",\n  \"location\": \"Oshodi Underbridge\",\n  \"latitude\": 6.5568,\n  \"longitude\": 3.3488,\n  \"notes\": \"Stopped at routine checkpoint\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/identify/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"identify",
								""
							]
						},
						"description": "Identify a suspect using facial recognition. Returns match logs, warrants, and offence summary."
					}
				},
				{
					"name": "Get Identification Logs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/identify/logs/?match_found=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"identify",
								"logs",
								""
							],
							"query": [
								{
									"key": "match_found",
									"value": "true"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Criminal Profiles (Subjects)",
			"item": [
				{
					"name": "List/Search Subjects",
					"request": {
						"method": "GET",
