							"mode": "raw",
							"raw": "{\n  \"image\": \"data:image/jpeg;base64,...(base64_string)...\",\n  \"is_primary\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/subjects/{{subject_id}}/enrol-mugshot/",
