					"name": "Log New Offence",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('offence_id', response.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"subject_id\": \"{{subject_id}}\",\n  \"offence_category\": \"ARMED_ROBBERY\",\n  \"offence_title\": \"Robbery at gunpoint — Oshodi Market\",\n  \"description\": \"Suspect robbed traders at gunpoint.\",\n  \"severity\": \"VIOLENT\",\n  \"incident_date\": \"2025-04-10T14:00:00Z\",\n  \"location\": \"Oshodi Market, Lagos\",\n  \"latitude\": 6.5568,\n  \"longitude\": 3.3488,\n  \"station_id\": \"{{station_id}}\"\n}",
							"options": {
