									"    pm.collectionVariables.set('subject_id', response.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"first_name\": \"Emeka\",\n  \"last_name\": \"Okafor\",\n  \"aliases\": [\"E-Boy\", \"Chairman\"],\n  \"date_of_birth\": \"1990-03-12\",\n  \"gender\": \"MALE\",\n  \"nationality\": \"Nigerian\",\n  \"state_of_origin\": \"Anambra\",\n  \"lga_of_origin\": \"Onitsha\",\n  \"address\": \"12 Bello Street, Mushin, Lagos\",\n  \"phone_numbers\": [\"+2348012345678\"],\n  \"identifying_marks\": \"Scar above left eyebrow\",\n  \"risk_level\": \"HIGH\",\n  \"status\": \"ACTIVE\",\n  \"is_armed_dangerous\": true\n}",
