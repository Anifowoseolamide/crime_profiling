{
	"info": {
		"_postman_id": "lagoscp-api-suite",
		"name": "LagosCP — Crime Profiling System API",
		"description": "Comprehensive API collection for the Lagos State Crime Profiling System (LagosCP). Includes face identification, criminal profiling, offence tracking, and audit trails.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "subject_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "offence_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "warrant_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "station_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "officer_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Officer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('access_token', response.access);",
									"    pm.collectionVariables.set('refresh_token', response.refresh);",
									"    pm.collectionVariables.set('officer_id', response.officer.id);",
									"    console.log('Officer session started: ' + response.officer.full_name);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"badge_number\": \"LSP-04821\",\n  \"password\": \"police123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login",
								""
							]
						},
						"description": "Authenticate an officer using badge number. Defaults to seeded Field Officer."
					}
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('access_token', response.access);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/refresh/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"refresh",
								""
							]
						}
					}
				},
				{
					"name": "Get My Profile (Me)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/me/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"me",
								""
							]
						}
					}
				},
				{
					"name": "List/Filter Officers",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/officers/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"officers",
								""
							]
						},
						"description": "Admin only view of all officers."
					}
				},
				{
					"name": "Create Peace Station",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('station_id', response.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Mushin Division HQ\",\n  \"division\": \"D\",\n  \"lga\": \"Mushin\",\n  \"address\": \"Agege Motor Road, Mushin, Lagos\",\n  \"phone\": \"08055551234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/stations/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"stations",
								""
							]
						}
					}
				}
			]
		},
		{
			"name": "Suspect Identification",
